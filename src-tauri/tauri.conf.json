{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BearNest_VPN_Tauri+Rust",
  "version": "2.10.4",
  "identifier": "com.bearnestclienttaurirust.vpn",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BearNest VPN-Client-Tauri+Rust",
        "width": 980,
        "height": 700,
        "minWidth": 520,
        "minHeight": 260,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "visible": false,
        "center": true
      },
      {
        "label": "splash",
        "url": "splash.html",
        "width": 860,
        "height": 450,
        "resizable": false, 
        "center": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "transparent": true
        
      },
      {
        "label": "editor",
        "title": "Редактор темы",
        "url": "editor.html",
        "width": 400,
        "height": 680,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "core/*": "core/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}

